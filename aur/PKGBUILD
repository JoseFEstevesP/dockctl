# Maintainer: gato99
#
# Publicar en AUR (una vez, con la cuenta ya creada en aur.archlinux.org):
#   git clone https://aur.archlinux.org/dockctl.git
#   cp /ruta/al/repo/aur/PKGBUILD dockctl/
#   cd dockctl && cp PKGBUILD . && makepkg --printsrcinfo > .SRCINFO
#   git add PKGBUILD .SRCINFO && git commit -m "dockctl 1.2.0-1" && git push
#
# En cada version nueva: subir pkgver/pkgrel y repetir el push con los dos ficheros.

pkgname=dockctl
pkgver=1.2.0
pkgrel=1
pkgdesc="App de bandeja para ver y gestionar los contenedores Docker"
arch=('any')
url="https://github.com/JoseFEstevesP/plasma-dockctl"
license=('GPL-3.0')
depends=('python' 'pyside6' 'kirigami' 'docker')
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/plasma-dockctl"
  printf '%s' "$(git describe --tags --always | sed 's/^v//')"
}

package() {
  cd "${srcdir}/plasma-dockctl"

  install -d "${pkgdir}/usr/lib/dockctl"
  cp -a app/qml "${pkgdir}/usr/lib/dockctl/qml"
  cp -a app/images "${pkgdir}/usr/lib/dockctl/images"
  install -Dm755 app/dockctl_app.py "${pkgdir}/usr/lib/dockctl/dockctl_app.py"
  install -Dm644 backend/backend.py "${pkgdir}/usr/lib/dockctl/backend.py"
  install -Dm644 backend/test_backend.py "${pkgdir}/usr/lib/dockctl/test_backend.py"

  install -Dm644 app/org.gato99.dockctl.desktop \
    "${pkgdir}/usr/share/applications/org.gato99.dockctl.desktop"
  install -Dm644 app/images/docker.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/dockctl.svg"

  install -d "${pkgdir}/usr/bin"
  ln -s /usr/lib/dockctl/dockctl_app.py "${pkgdir}/usr/bin/dockctl"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}

post_install() {
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true

  if [[ -f /usr/lib/systemd/user/dockctl.service ]]; then
    echo "AVISO: la version anterior (plasma-dockctl) dejo un servicio systemd."
    echo "       La app ya no necesita backend como servicio; para limpiarlo:"
    echo "         systemctl --user disable --now dockctl.service"
    echo "         sudo pacman -Rns plasma-dockctl"
  fi

  echo
  echo "dockctl ${pkgver}-${pkgrel} instalado."
  echo "  - Arrancala desde el menu (Contenedores Docker) o con: dockctl"
  echo "  - Queda en la bandeja del sistema; al cerrar la ventana se oculta ahi."
  echo "  - Tests del backend:  python /usr/lib/dockctl/test_backend.py"
}

post_upgrade() {
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
}

post_remove() {
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
}
